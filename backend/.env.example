# Copy to backend/.env. Keep the key on the server only; never put it in the mobile app or commit .env.
ANTHROPIC_API_KEY=
# Must be a model enabled for your Anthropic account.
CLAUDE_MODEL=claude-sonnet-5-5
ANTHROPIC_VERSION=2023-06-01
KARYA_RATE_LIMIT_PER_MINUTE=12

# Where word packs, the sync database and speech models live (default: backend/data).
# KARYA_DATA_DIR=./data
# KARYA_SPEECH_MODELS_DIR=./data/speech_models
